# 이 파일을 .secrets.sh 로 복사해서 값을 채운다. **.secrets.sh 는 커밋하지 않는다.**
#
#   cp .secrets.sh.example .secrets.sh && chmod 600 .secrets.sh
#
# sbatch 스크립트가 scripts/load_secrets.sh 를 통해 자동으로 읽는다.
# 값을 로그에 찍지 않으므로 out/*.out 에 남지 않는다.

# HuggingFace — RLWRLD/RLDX-1-* 가 private 이라 백본 로드에 필요하다.
# (HF_HUB_OFFLINE=1 로 캐시만 쓰는 잡에는 없어도 된다)
export HF_TOKEN=

# wandb — 없으면 로깅만 꺼지고 학습은 계속된다.
export WANDB_API_KEY=
